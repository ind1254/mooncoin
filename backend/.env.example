# Moonpaper — environment template. Copy to .env or set in your shell/Vercel.
# NEVER commit a filled-in copy of this file.

# ── Core ──────────────────────────────────────────────────────────────────
PORT=8787

# Market data. "demo" = deterministic simulation, "live" = on-chain + Jupiter.
MARKET_MODE=live

# Legacy arbitrage-calculator quotes: "mock" (offline) or "jupiter".
# NOTE: the jupiter path targets a retired host and is non-functional.
QUOTE_MODE=mock

# Directory for local JSON state (legacy simulator, settings, local dev DB).
DATA_DIR=data

# ── Accounts and persistence ──────────────────────────────────────────────
# SECRET. Postgres connection string. Without it the app still serves public
# research and quotes, but accounts, portfolios and watchlists are disabled.
# Neon example:
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/moonpaper?sslmode=require
# DATABASE_URL=

# Starting paper capital for a new account, in whole USD.
PAPER_STARTING_USD=100000

# Server-owned live paper-entry limits. The browser cannot weaken these.
PAPER_MIN_TRADE_USD=10
PAPER_MAX_TRADE_USD=10000
PAPER_MAX_OPEN_POSITIONS=25

# Durable Postgres-backed abuse limits. These work across serverless instances.
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_NETWORK_ATTEMPTS=60
PAPER_RATE_LIMIT_ATTEMPTS=30
PAPER_RATE_LIMIT_WINDOW_MS=60000

# How long a signed-in session lasts.
SESSION_TTL_DAYS=30

# Account verification and password recovery. Keep enforcement off until a
# verified Resend sender is configured; existing accounts are migrated as
# verified. PUBLIC_APP_URL is the only origin allowed in emailed links.
PUBLIC_APP_URL=https://mooncoin-two.vercel.app
EMAIL_VERIFICATION_REQUIRED=false
# RESEND_API_KEY=
# ACCOUNT_EMAIL_FROM=Moonpaper <accounts@your-verified-domain.example>

# Send Secure cookies. MUST be true in production (HTTPS).
# Set false only for plain-HTTP local development.
COOKIE_SECURE=true

# Local development only: with no DATABASE_URL, run a file-backed Postgres
# (PGlite) under DATA_DIR so accounts work offline. Never set in production.
# LOCAL_DB=true

# ── Providers (public, keyless) ───────────────────────────────────────────
# The public endpoint serves getAccountInfo fine, so mint and freeze authority
# verification works out of the box. It REFUSES getTokenLargestAccounts, so
# on-chain holder concentration degrades to "unavailable" and the research page
# falls back to the discovery provider's reported figure.
#
# To enable on-chain holder concentration, copy this file to backend/.env
# (gitignored, loaded automatically in local dev) and point this at a keyed
# provider — Helius, QuickNode, or Triton:
#   SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# In production, set it in the Vercel project's environment variables instead.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_TOKENS_URL=https://lite-api.jup.ag/tokens/v2
JUPITER_QUOTE_URL=https://lite-api.jup.ag/swap/v1
# Production Developer Platform key. Set this together with api.jup.ag URLs.
# JUPITER_API_KEY=
MINT_CACHE_TTL_MS=600000

# Server-side eligibility policy. Client filters cannot weaken these gates.
TRADABILITY_MIN_LIQUIDITY_USD=10000
TRADABILITY_MAX_PRICE_IMPACT_BPS=300
TRADABILITY_MAX_MARKET_AGE_MS=300000

# ── Optional ──────────────────────────────────────────────────────────────
# SECRET. Enables the legacy admin allowlist endpoints when set.
# ADMIN_TOKEN=
