# Moonpaper — environment template. Copy to .env or set in your shell.
# NO real values are required for demo mode; every variable has a safe default.

# HTTP port for the API + web app
PORT=8787

# Market data source. Only "demo" exists today: deterministic, seeded,
# clearly-labeled demonstration data. Live providers are a future phase.
MARKET_MODE=demo

# Legacy arbitrage-calculator quotes: "mock" (offline) or "jupiter" (live).
QUOTE_MODE=mock

# Virtual starting balance for the paper portfolio, in SOL.
PAPER_STARTING_SOL=100

# Directory for local JSON state (paper positions, settings). Gitignored.
DATA_DIR=data

# Optional: enables the legacy admin allowlist endpoints when set.
# Use a long random string; never commit the real value.
# ADMIN_TOKEN=
