{
  "name": "moonpaper-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Moonpaper — paper-trading decision-support API for Solana meme-coins. Simulation only: no trade execution, no key custody.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "dev:mock": "tsx watch src/api/server.ts --mock",
    "dev:live": "tsx watch src/api/server.ts --live",
    "start": "tsx src/api/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx src/db/runMigrations.ts",
    "migrate:if-configured": "tsx src/db/runMigrations.ts --if-configured",
    "test": "vitest run",
    "dev:local": "tsx watch src/api/server.ts --live"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.23.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
