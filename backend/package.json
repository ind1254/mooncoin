{
  "name": "fomo-arbitrage-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Calculation-only Solana arbitrage API for the FOMO iOS app. No trade execution, no key custody.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "dev:mock": "tsx watch src/api/server.ts --mock",
    "start": "tsx src/api/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
