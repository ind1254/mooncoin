{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["backend/dist/**", "web/**", "demo/**"] }
    },
    { "src": "web/**", "use": "@vercel/static" },
    { "src": "demo/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/health", "dest": "/api/index.js" },
    { "src": "/v1/(.*)", "dest": "/api/index.js" },
    { "src": "/admin/(.*)", "dest": "/api/index.js" },
    { "src": "/demo", "dest": "/demo/index.html" },
    { "src": "/demo/(.*)", "dest": "/demo/$1" },
    { "src": "/(app\\.js|styles\\.css)", "dest": "/web/$1" },
    { "src": "/", "dest": "/web/index.html" }
  ]
}
