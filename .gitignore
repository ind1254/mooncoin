!backend/dist/
!backend/dist/**

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Xcode
ios/**/xcuserdata/
ios/**/*.xcuserstate
DerivedData/

# Local tool state
.claude/settings.local.json

# Local dev database (PGlite)
backend/data/
